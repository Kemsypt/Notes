javascript:(async()=>{try{const load=s=>new Promise((res,rej)=>{if(window.html2canvas)return res();const sc=document.createElement('script');sc.src=s;sc.async=true;sc.onload=res;sc.onerror=()=>rej(new Error('Could not load html2canvas'));document.head.appendChild(sc)});await load('https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js');const wait=ms=>new Promise(r=>setTimeout(r,ms));const doc=document.documentElement,body=document.body;const oldX=window.scrollX,oldY=window.scrollY;const pageWidth=Math.max(doc.scrollWidth,doc.clientWidth,body?body.scrollWidth:0,body?body.clientWidth:0);const pageHeight=Math.max(doc.scrollHeight,doc.clientHeight,body?body.scrollHeight:0,body?body.clientHeight:0);const chunkHeight=5000;window.scrollTo(0,0);await wait(300);const fixedLike=[...document.querySelectorAll('*')].filter(el=>{const cs=getComputedStyle(el);return(cs.position==='fixed'||cs.position==='sticky')&&el!==document.body&&el!==document.documentElement});const fixedState=fixedLike.map(el=>[el,el.style.visibility]);fixedLike.forEach(el=>el.style.visibility='hidden');const baseName=((document.title||'page').replace(/[\\/:*?"<>|]+/g,'_')||'page');const totalParts=Math.ceil(pageHeight/chunkHeight);for(let i=0;i<totalParts;i++){const y=i*chunkHeight;const h=Math.min(chunkHeight,pageHeight-y);await wait(120);const canvas=await html2canvas(document.documentElement,{backgroundColor:'#ffffff',useCORS:true,allowTaint:false,logging:false,scale:1,x:0,y,width:pageWidth,height:h,windowWidth:pageWidth,windowHeight:h,scrollX:0,scrollY:0});const a=document.createElement('a');a.download=totalParts===1?baseName+'.png':baseName+'_part'+(i+1)+'-of-'+totalParts+'.png';a.href=canvas.toDataURL('image/png');document.body.appendChild(a);a.click();a.remove()}fixedState.forEach(([el,v])=>el.style.visibility=v);window.scrollTo(oldX,oldY);alert(totalParts===1?'Saved 1 image.':'Saved '+totalParts+' images.')}catch(e){alert('Capture failed: '+e.message)}})();