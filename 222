 if(!existing)checkpoint('case added');const values={...blankRecord(title),clientName,clientId};values.category=state.settings.categories[0].id;const r=existing||recordForCalendar(values);if(!existing&&title)r.title=title;folderId=r.id;noteId=null;$('newCaseDialog').close();persist();renderCalendar();loadNote(null);};
