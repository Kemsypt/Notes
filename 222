/* Routine saves stay quiet; only actionable problems appear in the header. */
function renderSaveIssue(){
 const status=$('saveStatus');if(!status)return;const issues=[];
 if(!storageOkay)issues.push('Browser save failed — export a backup');
 const links=[...fileLinks.values(),...(jsonLink?[jsonLink]:[]),...oneLinks.values()];for(const l of links)if(l.paused||l.waiting)issues.push((l.handle?.name||'Linked file')+' · '+(l.status||'Saving needs attention'));
 status.className=issues.length?'status save-error':'status';status.textContent=issues.length?issues[0]:'';status.title=issues.join('\n');
}
