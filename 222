/* Freeplace image positions are content coordinates inside the note canvas. */
var imageFreeDrag=null,imageFreeSuppressClickUntil=0;
function imagePosition(figure,x,y){x=Math.round(Math.max(0,Math.min(20000,Number(x)||0)));y=Math.round(Math.max(0,Math.min(50000,Number(y)||0)));figure.dataset.imageX=x;figure.dataset.imageY=y;figure.style.left=x+'px';figure.style.top=y+'px';}
function imageSetMode(mode){
 const img=imageSelected,figure=img?.closest('figure[data-casebook-image]');if(!figure)return;const free=mode==='freeplace';if((figure.dataset.imageMode==='freeplace')===free)return;
 checkpoint('image mode changed');if(free){const root=$('editor'),a=figure.getBoundingClientRect(),r=root.getBoundingClientRect();figure.dataset.imageMode='freeplace';imagePosition(figure,a.left-r.left+root.scrollLeft-root.clientLeft,a.top-r.top+root.scrollTop-root.clientTop);}else{delete figure.dataset.imageMode;delete figure.dataset.imageX;delete figure.dataset.imageY;figure.style.removeProperty('left');figure.style.removeProperty('top');}
 saveNote();imageSelect(img);$('editor').focus({preventScroll:true});
}
function imageFreeFinish(commit){
 const d=imageFreeDrag;if(!d)return;imageFreeDrag=null;imageFreeSuppressClickUntil=Date.now()+250;cancelAnimationFrame(d.frame);document.body.classList.remove('image-moving');
 if(!commit)imagePosition(d.figure,d.startX,d.startY);else if(+d.figure.dataset.imageX!==d.startX||+d.figure.dataset.imageY!==d.startY){checkpoint('image moved');saveNote();}
 try{d.figure.releasePointerCapture(d.pointer);}catch{}imageHandles();
}
function imageFreeMove(){
 const d=imageFreeDrag;if(!d)return;const root=$('editor'),r=root.getBoundingClientRect(),edge=28;
 let dx=0,dy=0;if(d.clientX<r.left+edge)dx=-10;else if(d.clientX>r.right-edge)dx=10;if(d.clientY<r.top+edge)dy=-10;else if(d.clientY>r.bottom-edge)dy=10;
 if(dx||dy)root.scrollBy(dx,dy);imagePosition(d.figure,d.startX+d.clientX-d.clientStartX+root.scrollLeft-d.scrollX,d.startY+d.clientY-d.clientStartY+root.scrollTop-d.scrollY);
 d.frame=requestAnimationFrame(imageFreeMove);
}
$('editor').addEventListener('pointerdown',e=>{const figure=e.target.closest('figure[data-image-mode="freeplace"]');if(!figure||e.button!==0||e.target.closest('[data-corner]'))return;e.preventDefault();e.stopImmediatePropagation();const img=figure.querySelector('img');imageSelect(img);const root=$('editor');root.focus({preventScroll:true});imageFreeDrag={figure,img,pointer:e.pointerId,startX:+figure.dataset.imageX||0,startY:+figure.dataset.imageY||0,clientStartX:e.clientX,clientStartY:e.clientY,clientX:e.clientX,clientY:e.clientY,scrollX:root.scrollLeft,scrollY:root.scrollTop};figure.setPointerCapture(e.pointerId);document.body.classList.add('image-moving');imageFreeMove();},true);
$('editor').addEventListener('pointermove',e=>{const d=imageFreeDrag;if(!d||d.pointer!==e.pointerId)return;e.preventDefault();d.clientX=e.clientX;d.clientY=e.clientY;},true);
$('editor').addEventListener('pointerup',e=>{if(imageFreeDrag?.pointer===e.pointerId){e.preventDefault();e.stopImmediatePropagation();const d=imageFreeDrag;d.clientX=e.clientX;d.clientY=e.clientY;const root=$('editor');imagePosition(d.figure,d.startX+d.clientX-d.clientStartX+root.scrollLeft-d.scrollX,d.startY+d.clientY-d.clientStartY+root.scrollTop-d.scrollY);imageFreeFinish(true);}},true);
$('editor').addEventListener('pointercancel',()=>imageFreeFinish(false),true);
window.addEventListener('blur',()=>imageFreeFinish(false));document.addEventListener('lostpointercapture',e=>{if(imageFreeDrag?.figure===e.target)imageFreeFinish(false);});
document.addEventListener('keydown',e=>{if(dragState?.active&&e.key==='Control'){dragState.ctrl=true;updateGesture();}});document.addEventListener('keyup',e=>{if(dragState?.active&&e.key==='Control'){dragState.ctrl=false;updateGesture();}});
