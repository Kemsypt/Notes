 const root=$('editor'),selection=window.getSelection();let bookmark=null;
 const position=(node,offset)=>{const r=document.createRange();r.selectNodeContents(root);r.setEnd(node,offset);return r.toString().length;};
 if(selection?.rangeCount&&root.contains(selection.anchorNode)&&root.contains(selection.focusNode)){const range=selection.getRangeAt(0);bookmark={start:position(range.startContainer,range.startOffset),end:position(range.endContainer,range.endOffset)};}
 const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT),nodes=[];let node;while(node=walker.nextNode())if(!node.parentElement.closest('a,[data-casebook-no-auto-link],[data-casebook-sheet],figure,[data-note-ui]'))nodes.push(node);
 let changed=false;for(const textNode of nodes){const text=textNode.nodeValue,matches=noteURLMatches(text).filter(m=>finalise||selection?.anchorNode!==textNode||selection.anchorOffset<m.start||selection.anchorOffset>m.rawEnd);if(!matches.length)continue;
  const fragment=document.createDocumentFragment();let offset=0;for(const m of matches){fragment.append(document.createTextNode(text.slice(offset,m.start)));const a=document.createElement('a');a.href=m.href;a.textContent=m.value;a.rel='noopener noreferrer';fragment.append(a);offset=m.end;}fragment.append(document.createTextNode(text.slice(offset)));textNode.replaceWith(fragment);changed=true;
 }
 if(changed&&bookmark){const points=[],walk=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let offset=0;while(node=walk.nextNode()){points.push({node,start:offset,end:offset+node.length});offset+=node.length;}const find=pos=>{const item=points.find(p=>pos<=p.end)||points.at(-1);return item?{node:item.node,offset:Math.max(0,Math.min(item.node.length,pos-item.start))}:null;};const start=find(bookmark.start),end=find(bookmark.end);if(start&&end){const range=document.createRange();range.setStart(start.node,start.offset);range.setEnd(end.node,end.offset);selection.removeAllRanges();selection.addRange(range);richSavedRange=range.cloneRange();}}
 return changed;
}
$('editor').addEventListener('blur',()=>{if(noteAutoLinks(true))saveNote();});
