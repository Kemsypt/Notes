const noteBaseColours=[['Black','#000000'],['Grey','#777777'],['White','#ffffff'],['Red','#c62828'],['Orange','#ef6c00'],['Yellow','#f9a825'],['Green','#2e7d32'],['Teal','#00838f'],['Blue','#1565c0'],['Purple','#6a1b9a'],['Pink','#c2185b'],['Brown','#6d4c41']];
function notePaletteClose(){const popup=$('textColourPalette');popup.classList.add('hidden');$('textColourBtn').setAttribute('aria-expanded','false');}
