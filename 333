  <script>
    const $ = (sel, root=document) => root.querySelector(sel);
    const $$ = (sel, root=document) => Array.from(root.querySelectorAll(sel));

    const LS_THEME_KEY = "basNoteBuilder.theme";
    const LS_TEMPLATE_KEY = "basNoteBuilder.template";

    function v(name) {
      const el = document.querySelector(`[name="${name}"]`);
      if (!el) return "";
      return (el.value ?? "").toString().trim();
    }

    function parseMoney(raw) {
      if (!raw) return "";
      const cleaned = String(raw).replace(/[\\s,$]/g, "");
      const n = Number(cleaned);
      if (!Number.isFinite(n)) return raw.trim();
      return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function ynWord(val) {
      if (val === "Y") return "Yes";
      if (val === "N") return "No";
      return val || "";
    }

    function expandingScopeLine() {
      const ynRaw = v("expandingScope") || "";
      const yn = ynWord(ynRaw);
      const date = v("expandingScopeDate");
      if (ynRaw === "Y") return `Expanding Scope: ${yn} - ${date || ""}`.trim();
      return `Expanding Scope: ${yn}`.trim();
    }

    function ynExplainLine(label, ynName, explainName) {
      const ynRaw = v(ynName) || "";
      const yn = ynWord(ynRaw);
      const explain = v(explainName);
      if (ynRaw === "Y") return `${label}: ${yn} - ${explain || ""}`.trim();
      return `${label}: ${yn}`.trim();
    }


    function moneyLine(label, name) {
      const val = v(name);
      return `${label}: $${parseMoney(val)}`;
    }

    function buildVariables() {
      const vars = {
        caseId: v("caseId"),
        client: v("client"),
        day30: v("day30"),
        risk: v("risk"),
        suppression: ynWord(v("suppression")),
        por: v("por"),

        expandingScope: ynWord(v("expandingScope")),
        expandingScopeDate: v("expandingScopeDate"),
        expandingScopeLine: expandingScopeLine(),

        previousCompliance: v("previousCompliance"),
        basLodgedOn: v("basLodgedOn"),
        basLodgedVia: v("basLodgedVia"),
        basLodgedBy: v("basLodgedBy"),
        relatedEntities: v("relatedEntities"),

        g1: `$${parseMoney(v("g1"))}`,
        oneA: `$${parseMoney(v("oneA"))}`,
        g11: `$${parseMoney(v("g11"))}`,
        oneB: `$${parseMoney(v("oneB"))}`,
        nine: `$${parseMoney(v("nine"))}`,
        otherComments: v("otherComments"),

        attributionFrequency: v("attributionFrequency"),
        abnStartDate: v("abnStartDate"),
        gstStartDate: v("gstStartDate"),

        anzicCode: v("anzicCode"),
        entityType: v("entityType"),
        businessAddress: v("businessAddress"),
        tradingNames: v("tradingNames"),

        fidUpdateDate: v("fidUpdateDate"),
        fidLinkedEntities: v("fidLinkedEntities"),
        cch: v("cch"),
        signsOfEnterprise: v("signsOfEnterprise"),

        compromisedIndicatorsLine: ynExplainLine("Compromised Indicators", "compromisedIndicators", "compromisedIndicatorsExplain"),
        compromisedIndicators: ynWord(v("compromisedIndicators")),
        compromisedIndicatorsExplain: v("compromisedIndicatorsExplain"),

        alertsLine: ynExplainLine("Alerts", "alerts", "alertsExplain"),
        alerts: ynWord(v("alerts")),
        alertsExplain: v("alertsExplain"),

        recentContactChangesLine: ynExplainLine("Recent Contact Changes", "recentContactChanges", "recentContactChangesExplain"),
        recentContactChanges: ynWord(v("recentContactChanges")),
        recentContactChangesExplain: v("recentContactChangesExplain"),

        itrForBasPeriod: ynWord(v("itrForBasPeriod")),
        businessIncomeOnItr: v("businessIncomeOnItr"),
        employmentDescriptionOnItr: v("employmentDescriptionOnItr"),
        centrelinkBenefits: ynWord(v("centrelinkBenefits")),
        googleClientName: v("googleClientName"),
        googleTradingName: v("googleTradingName"),
        itrOther: v("itrOther"),

        merchantRecords: ynWord(v("merchantRecords")),
        ecp: ynWord(v("ecp")),
        commercialVehicleReg: ynWord(v("commercialVehicleReg")),

        rideShareLine: ynExplainLine("Ride Share", "rideShare", "rideShareExplain"),
        rideShare: ynWord(v("rideShare")),
        rideShareExplain: v("rideShareExplain"),

        tparsLine: ynExplainLine("TPARS Data", "tpars", "tparsExplain"),
        tpars: ynWord(v("tpars")),
        tparsExplain: v("tparsExplain"),

        austracLine: ynExplainLine("Austrac Data", "austrac", "austracExplain"),
        austrac: ynWord(v("austrac")),
        austracExplain: v("austracExplain"),

        thirdPartyOther: v("thirdPartyOther"),
        treatmentType: v("treatmentType"),

        g1Line: moneyLine("Total Sales G1", "g1"),
        oneALine: moneyLine("Total GST Sales POR 1A", "oneA"),
        g11Line: moneyLine("Total Acquisitions G11", "g11"),
        oneBLine: moneyLine("Total GST Credits for POR 1B", "oneB"),
        nineLine: moneyLine("Total Refund for POR 9", "nine"),
      };
      return vars;
    }

    function applyTemplate(template, vars) {
      // Replace placeholders like {{caseId}} with values from vars.
      // Supports any key text inside the braces; unknown keys become blank.
      return template.replace(/\{\{\s*([^}]+?)\s*\}\}/g, (match, rawKey) => {
        const key = String(rawKey).trim();
        const val = Object.prototype.hasOwnProperty.call(vars, key) ? vars[key] : "";
        return (val === undefined || val === null) ? "" : String(val);
      });
    }

    const DEFAULT_TEMPLATE = `General Client Info
Case ID: {{caseId}}
Client: {{client}}
Day 30:  {{day30}}
Risk: {{risk}}
Suppression: {{suppression}}
POR: {{por}}
{{expandingScopeLine}}
Previous Compliance History/Former Audits:  {{previousCompliance}}
BAS Lodgement Lodged on {{basLodgedOn}} via {{basLodgedVia}} by {{basLodgedBy}}
Related Entities: {{relatedEntities}}
BAS Labels
{{g1Line}}
{{oneALine}}
{{g11Line}}
{{oneBLine}}
{{nineLine}}
Other comments: {{otherComments}}
GST Account & Rego
Attribution /Frequency: {{attributionFrequency}}
ABN Start Date: {{abnStartDate}}
GST Start Date: {{gstStartDate}}
Main Business Activity
ANZIC Code: {{anzicCode}}
Entity Type: {{entityType}}
Business address: {{businessAddress}}
Business/Trading Names: {{tradingNames}}

3rd party Fraud Indicators
FID Update date: {{fidUpdateDate}}
FID Linked To other entities: {{fidLinkedEntities}} RAPT check completed
{{compromisedIndicatorsLine}}
{{alertsLine}}
{{recentContactChangesLine}}
CCH: {{cch}}
Signs of Enterprise
ITR for BAS period: {{itrForBasPeriod}}
Business Income on ITR: {{businessIncomeOnItr}}
Employment Description on ITR:  {{employmentDescriptionOnItr}}
Centrelink Benefits:  {{centrelinkBenefits}}
Google Client/individual Name: {{googleClientName}}
Google Trading/Business name: {{googleTradingName}}
Other: {{itrOther}}
Third Party Data
Merchant Records: {{merchantRecords}}
ECP Licenses/Permits/Study Courses: {{ecp}}
Commercial Vehicle Registration: {{commercialVehicleReg}}
{{rideShareLine}}
{{tparsLine}}
{{austracLine}}
Other: {{thirdPartyOther}}
Treatment type
{{treatmentType}}`;

    function getTemplate() {
      return localStorage.getItem(LS_TEMPLATE_KEY) || DEFAULT_TEMPLATE;
    }
    function setTemplate(t) {
      localStorage.setItem(LS_TEMPLATE_KEY, t);
    }

    function buildNote() {
      const vars = buildVariables();
      const note = applyTemplate(getTemplate(), vars).trim();
      $("#preview").textContent = note;
      return note;
    }

    async function copyFullNote() {
      const form = $("#noteForm");
      if (!form.reportValidity()) return;

      const note = buildNote();

      try {
        await navigator.clipboard.writeText(note);
        $("#status").textContent = "Copied full note to clipboard.";
        setTimeout(() => $("#status").textContent = "", 2500);
      } catch (e) {
        const ta = document.createElement("textarea");
        ta.value = note;
        ta.style.position = "fixed";
        ta.style.left = "-9999px";
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand("copy");
        document.body.removeChild(ta);

        $("#status").textContent = ok ? "Copied full note to clipboard." : "Clipboard copy failed (browser blocked it).";
        setTimeout(() => $("#status").textContent = "", 2500);
      }
    }

    function setExplainVisibility(box, yes) {
      box.dataset.show = yes ? "true" : "false";
      const explainEl = box.querySelector("[data-ynx-explain]");
      if (!explainEl) return;
      if (explainEl.hasAttribute("data-required-when-yes")) explainEl.required = !!yes;
      if (!yes) explainEl.value = "";
    }

    function initYNX() {
      $$("[data-ynx]").forEach(box => {
        const sel = box.querySelector("[data-ynx-select]");
        if (!sel) return;
        const onChange = () => setExplainVisibility(box, sel.value === "Y");
        sel.addEventListener("change", onChange);
        onChange();
      });
    }

    function initPreviewUpdates() {
      const update = () => buildNote();
      document.addEventListener("input", (e) => {
        if (e.target && e.target.closest("#noteForm")) update();
      });
      update();
    }

    function setTheme(theme) {
      document.body.dataset.theme = theme;
      localStorage.setItem(LS_THEME_KEY, theme);
    }
    function initTheme() {
      const saved = localStorage.getItem(LS_THEME_KEY) || "grey";
      setTheme(saved);
      $$("[data-theme-pick]").forEach(btn => {
        btn.addEventListener("click", () => setTheme(btn.getAttribute("data-theme-pick")));
      });
    }

    function openSettings() {
      $("#settingsOverlay").dataset.open = "true";
      $("#settingsOverlay").setAttribute("aria-hidden", "false");
      $("#templateEditor").value = getTemplate();
      setTab("template");
      $("#templateEditor").focus();
    }
    function closeSettings() {
      $("#settingsOverlay").dataset.open = "false";
      $("#settingsOverlay").setAttribute("aria-hidden", "true");
    }
    function setTab(which) {
      const isTemplate = which === "template";
      $("#tabTemplate").setAttribute("aria-selected", isTemplate ? "true" : "false");
      $("#tabTheme").setAttribute("aria-selected", isTemplate ? "false" : "true");
      $("#panelTemplate").dataset.show = isTemplate ? "true" : "false";
      $("#panelTheme").dataset.show = isTemplate ? "false" : "true";
    }

    function initSettings() {
      $("#settingsBtn").addEventListener("click", openSettings);
      $("#closeSettings").addEventListener("click", closeSettings);
      $("#settingsOverlay").addEventListener("click", (e) => {
        if (e.target === $("#settingsOverlay")) closeSettings();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && $("#settingsOverlay").dataset.open === "true") closeSettings();
      });

      $("#tabTemplate").addEventListener("click", () => setTab("template"));
      $("#tabTheme").addEventListener("click", () => setTab("theme"));

      $("#saveTemplate").addEventListener("click", () => {
        setTemplate($("#templateEditor").value || DEFAULT_TEMPLATE);
        $("#status").textContent = "Template saved.";
        setTimeout(() => $("#status").textContent = "", 2000);
        buildNote();
      });

      $("#resetTemplate").addEventListener("click", () => {
        $("#templateEditor").value = DEFAULT_TEMPLATE;
        setTemplate(DEFAULT_TEMPLATE);
        $("#status").textContent = "Template reset to default.";
        setTimeout(() => $("#status").textContent = "", 2000);
        buildNote();
      });
    }

    initYNX();
    initTheme();
    initSettings();
    initPreviewUpdates();

    $("#copyBtn").addEventListener("click", copyFullNote);
    $("#noteForm").addEventListener("reset", () => setTimeout(() => { initYNX(); buildNote(); }, 0));
  </script>
