<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Client BAS / GST Note Builder</title>
  <style>
    :root{
      --gap: 12px;

      /* Theme variables (default: grey) */
      --bg: #f6f7f9;
      --panel: #ffffff;
      --panel-2: #fcfcfd;
      --text: #111827;
      --muted: #475467;
      --border: #d6d9de;
      --border-2: #cfd5dd;
      --accent: #2563eb;
      --accent-2: #111827;
      --btn-text: #ffffff;
      --shadow: 0 10px 30px rgba(17,24,39,.12);
      --overlay: rgba(17,24,39,.55);
    }

    body[data-theme="white"]{
      --bg:#ffffff;
      --panel:#ffffff;
      --panel-2:#f8fafc;
      --text:#0f172a;
      --muted:#475467;
      --border:#e2e8f0;
      --border-2:#e2e8f0;
      --accent:#2563eb;
      --accent-2:#0f172a;
      --btn-text:#ffffff;
      --shadow: 0 10px 30px rgba(15,23,42,.10);
      --overlay: rgba(15,23,42,.55);
    }
    body[data-theme="grey"]{
      --bg:#f6f7f9;
      --panel:#ffffff;
      --panel-2:#fcfcfd;
      --text:#111827;
      --muted:#475467;
      --border:#d6d9de;
      --border-2:#cfd5dd;
      --accent:#2563eb;
      --accent-2:#111827;
      --btn-text:#ffffff;
      --shadow: 0 10px 30px rgba(17,24,39,.12);
      --overlay: rgba(17,24,39,.55);
    }
    body[data-theme="dark"]{
      --bg:#0b1220;
      --panel:#0f172a;
      --panel-2:#111c33;
      --text:#e5e7eb;
      --muted:#a3aab8;
      --border:#26324a;
      --border-2:#2b3852;
      --accent:#60a5fa;
      --accent-2:#93c5fd;
      --btn-text:#0b1220;
      --shadow: 0 10px 30px rgba(0,0,0,.45);
      --overlay: rgba(0,0,0,.65);
    }
    /* Taylor Swift inspired theme (referential name) */
    body[data-theme="lavender-haze"]{
      /* Inspired by the Eras Tour Lavender Haze performance: neon purples + electric pink + stage-blue highlights */
      --bg:#090016;          /* deep stage-black with purple tint */
      --panel:#15003a;       /* saturated violet */
      --panel-2:#1f0061;     /* brighter violet */
      --text:#f5e9ff;        /* soft lavender-white */
      --muted:#f0abfc;       /* hot lavender */
      --border:#3b0a8f;      /* neon border */
      --border-2:#4c11b8;    /* brighter border */
      --accent:#a855f7;      /* vivid purple */
      --accent-2:#fb7185;    /* electric pink */
      --btn-text:#090016;
      --shadow: 0 16px 40px rgba(0,0,0,.60);
      --overlay: rgba(9,0,22,.78);
    }

    /* Taylor Swift inspired theme: Champagne Problems */
    body[data-theme="champagne-problems"]{
      /* Warm piano-stage amber + champagne gold */
      --bg:#120c07;          /* deep warm brown */
      --panel:#1b120c;       /* espresso */
      --panel-2:#24170f;     /* slightly lighter */
      --text:#fff7ed;        /* warm cream */
      --muted:#f7d7a7;       /* champagne highlight */
      --border:#4a2d1a;      /* warm border */
      --border-2:#5b371f;    /* brighter border */
      --accent:#fbbf24;      /* champagne gold */
      --accent-2:#f97316;    /* warm amber/orange */
      --btn-text:#120c07;
      --shadow: 0 16px 40px rgba(0,0,0,.65);
      --overlay: rgba(18,12,7,.78);
    }

    /* Taylor Swift inspired theme: Cruel Summer (Lover era - bright sunset) */
    body[data-theme="cruel-summer"]{
      --bg:#0b1020;          /* night sky */
      --panel:#131a33;       /* deep navy */
      --panel-2:#182046;     /* brighter navy */
      --text:#fff7ed;        /* warm cream */
      --muted:#fecdd3;       /* blush */
      --border:#25315f;      /* navy border */
      --border-2:#2f3c77;    /* brighter border */
      --accent:#fb7185;      /* hot pink */
      --accent-2:#fbbf24;    /* golden */
      --btn-text:#0b1020;
      --shadow: 0 16px 40px rgba(0,0,0,.60);
      --overlay: rgba(11,16,32,.78);
    }

    /* Taylor Swift inspired theme: Midnight Rain (Midnights era - cobalt + indigo) */
    body[data-theme="midnight-rain"]{
      --bg:#040814;          /* very deep midnight */
      --panel:#0a1230;       /* indigo */
      --panel-2:#0e1a45;     /* brighter indigo */
      --text:#e0f2fe;        /* icy light */
      --muted:#93c5fd;       /* soft blue */
      --border:#1e2b66;      /* border */
      --border-2:#273685;    /* brighter border */
      --accent:#22d3ee;      /* electric cyan */
      --accent-2:#a855f7;    /* vivid purple */
      --btn-text:#040814;
      --shadow: 0 16px 40px rgba(0,0,0,.65);
      --overlay: rgba(4,8,20,.78);
    }

    /* Taylor Swift inspired theme: Karma Is My UI (Eras Tour - neon orange/green burst) */
    body[data-theme="karma"]{
      --bg:#070c00;          /* dark olive-black */
      --panel:#111a00;       /* deep green */
      --panel-2:#162300;     /* brighter green */
      --text:#fefce8;        /* warm light */
      --muted:#bbf7d0;       /* mint */
      --border:#2a3a05;      /* border */
      --border-2:#355008;    /* brighter border */
      --accent:#fb923c;      /* neon orange */
      --accent-2:#4ade80;    /* neon green */
      --btn-text:#070c00;
      --shadow: 0 16px 40px rgba(0,0,0,.65);
      --overlay: rgba(7,12,0,.78);
    }

    /* Cat themes */
    body[data-theme="andy"]{
      /* Black cat: inky noir with emerald eyes */
      --bg:#050607;
      --panel:#0c0f12;
      --panel-2:#11161b;
      --text:#f3f4f6;
      --muted:#a3aab8;
      --border:#222a33;
      --border-2:#2b3642;
      --accent:#22c55e;      /* emerald */
      --accent-2:#94a3b8;    /* steel */
      --btn-text:#050607;
      --shadow: 0 16px 40px rgba(0,0,0,.70);
      --overlay: rgba(5,6,7,.78);
    }

    body[data-theme="rory"]{
      /* Ginger cat: warm orange + cream */
      --bg:#1a0f0a;
      --panel:#24140d;
      --panel-2:#2e1b12;
      --text:#fff7ed;
      --muted:#fed7aa;
      --border:#4a2a1a;
      --border-2:#5b341f;
      --accent:#fb923c;      /* orange */
      --accent-2:#fbbf24;    /* gold */
      --btn-text:#1a0f0a;
      --shadow: 0 16px 40px rgba(0,0,0,.70);
      --overlay: rgba(26,15,10,.78);
    }

    body[data-theme="percy"]{
      /* White/black/grey cat: soft monochrome with cool blue accent */
      --bg:#0b0f14;
      --panel:#121824;
      --panel-2:#182032;
      --text:#f8fafc;
      --muted:#cbd5e1;
      --border:#263247;
      --border-2:#33435f;
      --accent:#e5e7eb;      /* light grey */
      --accent-2:#60a5fa;    /* cool blue */
      --btn-text:#0b0f14;
      --shadow: 0 16px 40px rgba(0,0,0,.65);
      --overlay: rgba(11,15,20,.78);
    }

    /* Doctor Who themes */
    body[data-theme="dr-who"]{
      /* Classic sci-fi: deep space + sonic teal + warning red */
      --bg:#030712;
      --panel:#0b1020;
      --panel-2:#0f1730;
      --text:#e5e7eb;
      --muted:#93c5fd;
      --border:#1f2a44;
      --border-2:#273457;
      --accent:#22d3ee;      /* sonic teal */
      --accent-2:#ef4444;    /* warning red */
      --btn-text:#030712;
      --shadow: 0 16px 40px rgba(0,0,0,.70);
      --overlay: rgba(3,7,18,.78);
    }

    body[data-theme="tardis"]{
      /* Iconic police box blue */
      --bg:#030a1a;
      --panel:#061235;
      --panel-2:#0a1a4a;
      --text:#f8fafc;
      --muted:#bfdbfe;
      --border:#17306b;
      --border-2:#1f3b85;
      --accent:#2563eb;      /* TARDIS blue */
      --accent-2:#fbbf24;    /* warm light from windows */
      --btn-text:#030a1a;
      --shadow: 0 16px 40px rgba(0,0,0,.70);
      --overlay: rgba(3,10,26,.78);
    }

    body[data-theme="amy-pond"]{
      /* Vibrant red/orange with warm earth tones */
      --bg:#140702;          /* deep earth */
      --panel:#240b05;       /* dark umber */
      --panel-2:#331007;     /* warm brown */
      --text:#fff7ed;        /* cream */
      --muted:#fdba74;       /* warm amber */
      --border:#5b1b0f;      /* brick */
      --border-2:#7a2313;    /* brighter brick */
      --accent:#ef4444;      /* vibrant red */
      --accent-2:#f97316;    /* vibrant orange */
      --btn-text:#140702;
      --shadow: 0 16px 40px rgba(0,0,0,.70);
      --overlay: rgba(20,7,2,.78);
    }

    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 0; background: var(--bg); color: var(--text); }
    .wrap { max-width: 1100px; margin: 24px auto; padding: 16px; }
    h1 { margin: 0 0 6px; font-size: 20px; }
    .sub { margin: 0 0 14px; color: var(--muted); font-size: 13px; }

    fieldset { border: 1px solid var(--border); background: var(--panel); border-radius: 10px; padding: 14px; margin: 12px 0; }
    legend { padding: 0 8px; font-weight: 700; color: var(--text); }

    .grid { display: grid; gap: var(--gap); }
    .g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .g3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .g4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    @media (max-width: 860px) { .g2,.g3,.g4 { grid-template-columns: 1fr; } }

    label { display: grid; gap: 6px; font-size: 13px; color: var(--text); }
    input, select, textarea {
      width: 100%;
      padding: 10px 10px;
      border: 1px solid var(--border-2);
      border-radius: 8px;
      font-size: 14px;
      background: var(--panel);
      color: var(--text);
      font-family: inherit;
    }
    textarea { min-height: 88px; resize: vertical; }
    .hint { font-size: 12px; color: var(--muted); margin-top: 6px; }

    .ynx { border: 1px dashed var(--border-2); border-radius: 10px; padding: 10px; background: var(--panel-2); }
    .ynx .explain { margin-top: 10px; display:none; }
    .ynx[data-show="true"] .explain { display:block; }

    .actions {
      position: sticky; bottom: 0;
      background: rgba(0,0,0,0);
      padding: 12px 0 0;
      backdrop-filter: blur(4px);
    }
    .bar {
      display:flex; gap: 10px; flex-wrap: wrap; align-items:center; justify-content: space-between;
      background: var(--panel); border:1px solid var(--border); border-radius: 12px; padding: 12px;
      box-shadow: var(--shadow);
    }
    .btnrow { display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }

    button {
      border: 0; border-radius: 10px; padding: 10px 12px; font-weight: 800; cursor:pointer;
      background: var(--accent); color: var(--btn-text); font-size: 14px;
    }
    button.ghost { background: #e5e7eb; color: #111827; border:1px solid var(--border); }
    body[data-theme="dark"] button.ghost,
    body[data-theme="lavender-haze"] button.ghost,
    body[data-theme="champagne-problems"] button.ghost,
    body[data-theme="cruel-summer"] button.ghost,
    body[data-theme="midnight-rain"] button.ghost,
    body[data-theme="karma"] button.ghost,
    body[data-theme="andy"] button.ghost,
    body[data-theme="rory"] button.ghost,
    body[data-theme="percy"] button.ghost,
    body[data-theme="dr-who"] button.ghost,
    body[data-theme="tardis"] button.ghost,
    body[data-theme="amy-pond"] button.ghost,
    
      background: color-mix(in srgb, var(--panel) 80%, #000);
      color: var(--text);
    }
    button.secondary { background: var(--accent-2); color: var(--btn-text); }
    .status { font-size: 13px; color: var(--muted); }

    details { background: var(--panel); border:1px solid var(--border); border-radius: 12px; padding: 10px 12px; }
    summary { cursor:pointer; font-weight: 800; color: var(--text); }
    pre { white-space: pre-wrap; word-break: break-word; margin: 10px 0 0; font-size: 13px; color: var(--text); }

    /* Modal */
    .modalOverlay{
      position: fixed; inset: 0; background: var(--overlay);
      display:none; align-items: center; justify-content: center; padding: 18px;
      z-index: 9999;
    }
    .modalOverlay[data-open="true"]{ display:flex; }
    .modal{
      width: min(860px, 100%);
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .modalHeader{
      display:flex; align-items:center; justify-content: space-between;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
      gap: 10px;
    }
    .modalHeader .title{ font-weight: 900; }
    .modalHeader .close{
      background: transparent; color: var(--text); border: 1px solid var(--border);
      padding: 8px 10px; border-radius: 10px; font-weight: 900;
    }
    .tabs{
      display:flex; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--border);
      background: var(--panel-2);
      flex-wrap: wrap;
    }
    .tab{
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text);
      padding: 8px 10px;
      border-radius: 999px;
      font-weight: 900;
    }
    .tab[aria-selected="true"]{
      border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
      outline: 2px solid color-mix(in srgb, var(--accent) 40%, transparent);
      outline-offset: 1px;
    }
    .modalBody{ padding: 14px; }
    .panel{ display:none; }
    .panel[data-show="true"]{ display:block; }

    .themeGrid{
      display:grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    @media (max-width: 980px) { .themeGrid{ grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 720px) { .themeGrid{ grid-template-columns: 1fr; } }

    .themeCard{
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      background: var(--panel-2);
      display:flex;
      flex-direction: column;
      gap: 10px;
    }
    .swatches{ display:flex; gap: 8px; align-items:center; }
    .swatch{ width: 18px; height: 18px; border-radius: 999px; border:1px solid var(--border); }
    .themeCard .name{ font-weight: 900; }
    .themeCard .desc{ color: var(--muted); font-size: 12px; margin-top: -6px; }

    .small { font-size: 12px; color: var(--muted); }
    .small a, .small a:visited { color: inherit; text-decoration: underline; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
  </style>
</head>

<body data-theme="grey">
  <div class="wrap">
    <h1>Client BAS / GST Note Builder</h1>
    

    <form id="noteForm" novalidate>
      <fieldset>
        <legend>General Client Info</legend>
        <div class="grid g3">
          <label>Case ID
            <input name="caseId" type="text" />
          </label>
          <label>Client
            <input name="client" type="text" />
          </label>
          <label>Day 30
            <input name="day30" type="text" />
          </label>
          <label>Risk
            <input name="risk" type="text" />
          </label>
          <label>Suppression
            <select name="suppression">
              <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
            </select>
          </label>
          <label>POR
            <input name="por" type="text"  />
          </label>
        </div>

        <div class="grid g2" style="margin-top:12px;">
          <div class="ynx" data-ynx>
            <label>Expanding Scope
              <select name="expandingScope" data-ynx-select>
                <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
              </select>
            </label>
            <div class="explain">
              <label>Date
                <input name="expandingScopeDate" type="date" data-ynx-explain data-required-when-yes />
              </label>
            </div>
          </div>

          <label>Previous Compliance History/Former Audits
            <textarea name="previousCompliance"></textarea>
          </label>
        </div>

        <div class="grid g3" style="margin-top:12px;">
          <label>BAS Lodgement - Lodged on
            <input name="basLodgedOn" type="text" />
          </label>
          <label>BAS Lodgement - via
            <input name="basLodgedVia" type="text" />
          </label>
          <label>BAS Lodgement - by
            <input name="basLodgedBy" type="text" />
          </label>
        </div>

        <label style="margin-top:12px;">Related Entities
          <textarea name="relatedEntities"></textarea>
        </label>
      </fieldset>

      <fieldset>
        <legend>BAS Labels</legend>
        <div class="grid g3">
          <label class="money">Total Sales G1 ($)
            <input name="g1" inputmode="decimal" placeholder="0.00" data-money />
          </label>
          <label class="money">Total GST Sales POR 1A ($)
            <input name="oneA" inputmode="decimal" placeholder="0.00" data-money />
          </label>
          <label class="money">Total Acquisitions G11 ($)
            <input name="g11" inputmode="decimal" placeholder="0.00" data-money />
          </label>
          <label class="money">Total GST Credits for POR 1B ($)
            <input name="oneB" inputmode="decimal" placeholder="0.00" data-money />
          </label>
          <label class="money">Total Refund for POR 9 ($)
            <input name="nine" inputmode="decimal" placeholder="0.00" data-money />
          </label>
        </div>

        <label style="margin-top:12px;">Other comments
          <textarea name="otherComments"></textarea>
        </label>
      </fieldset>

      <fieldset>
        <legend>GST Account &amp; Rego</legend>
        <div class="grid g3">
          <label>Attribution/Frequency
            <input name="attributionFrequency" type="text" / placeholder="Cash/Accruals | quarterly/monthly/yearly">
          </label>
          <label>ABN Start Date
            <input name="abnStartDate" type="text" />
          </label>
          <label>GST Start Date
            <input name="gstStartDate" type="text" />
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Main Business Activity</legend>
        <div class="grid g3">
          <label>ANZIC Code
            <input name="anzicCode" type="text" />
          </label>
          <label>Entity Type
            <input name="entityType" type="text" / placeholder="Individual/Sole Trader/Partnership/Trust/Company">
          </label>
          <label>Business/Trading Names
            <input name="tradingNames" type="text" />
          </label>
        </div>

        <label style="margin-top:12px;">Business address (notes)
          <textarea name="businessAddress"></textarea>
        </label>
      </fieldset>

      <fieldset>
        <legend>3rd party Fraud Indicators</legend>
        <div class="grid g3">
          <label>FID Update date
            <input name="fidUpdateDate" type="text" />
          </label>
          <label>FID Linked To other entities (RAPT check completed)
            <input name="fidLinkedEntities" type="text" />
          </label>
          <label>CCH
            <input name="cch" type="text" />
          </label>
        </div>

        <div class="grid g3" style="margin-top:12px;">
          <div class="ynx" data-ynx>
            <label>Compromised Indicators
              <select name="compromisedIndicators" data-ynx-select>
                <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
              </select>
            </label>
            <div class="explain">
              <label>Explanation
                <textarea name="compromisedIndicatorsExplain" data-ynx-explain data-required-when-yes></textarea>
              </label>
            </div>
          </div>

          <div class="ynx" data-ynx>
            <label>Alerts
              <select name="alerts" data-ynx-select>
                <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
              </select>
            </label>
            <div class="explain">
              <label>Explanation
                <textarea name="alertsExplain" data-ynx-explain data-required-when-yes></textarea>
              </label>
            </div>
          </div>

          <div class="ynx" data-ynx>
            <label>Recent Contact Changes
              <select name="recentContactChanges" data-ynx-select>
                <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
              </select>
            </label>
            <div class="explain">
              <label>Explanation
                <textarea name="recentContactChangesExplain" data-ynx-explain data-required-when-yes></textarea>
              </label>
            </div>
          </div>
        </div>

        <label style="margin-top:12px;">Signs of Enterprise
          <textarea name="signsOfEnterprise"></textarea>
        </label>
      </fieldset>

      <fieldset>
        <legend>ITR / Benefits / Google checks</legend>
        <div class="grid g3">
          <label>ITR for BAS period
            <select name="itrForBasPeriod">
              <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
            </select>
          </label>
          <label>Business Income on ITR
            <input name="businessIncomeOnItr" type="text" />
          </label>
          <label>Employment Description on ITR
            <input name="employmentDescriptionOnItr" type="text" />
          </label>
          <label>Centrelink Benefits
            <select name="centrelinkBenefits">
              <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
            </select>
          </label>
          <label>Google Client/individual Name
            <input name="googleClientName" type="text" />
          </label>
          <label>Google Trading/Business name
            <input name="googleTradingName" type="text" />
          </label>
        </div>

        <label style="margin-top:12px;">Other
          <textarea name="itrOther"></textarea>
        </label>
      </fieldset>

      <fieldset>
        <legend>Third Party Data</legend>
        <div class="grid g3">
          <label>Merchant Records
            <select name="merchantRecords">
              <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
            </select>
          </label>
          <label>ECP Licenses/Permits/Study Courses
            <select name="ecp">
              <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
            </select>
          </label>
          <label>Commercial Vehicle Registration
            <select name="commercialVehicleReg">
              <option value=""></option><option value="Y">Yes</option><option value="N">No</option>
            </select>
          </label>
        </div>

        <div class="grid g3" style="margin-top:12px;">
          <div class="ynx" data-ynx>
